# ============================================================
# AI-for-NQP · .gitignore
# ============================================================

# ---- 依赖 / Dependencies ----
node_modules/

# ---- 构建产物 / Build output ----
# 运行 `npm run build` 即可重新生成
dist/
dist-ssr/
*.local

# ---- Vite / 工具缓存 / Tool caches ----
.vite/
.cache/
.eslintcache
*.tsbuildinfo
coverage/

# ---- 日志 / Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- 环境变量 / Environment files ----
.env
.env.*
!.env.example

# ---- 编辑器 / Editors & IDEs ----
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- 操作系统 / OS files ----
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- AI 助手本地配置 / Local assistant settings ----
.claude/
